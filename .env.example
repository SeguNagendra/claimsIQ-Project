# Replace username, password and port with the values configured for your existing PostgreSQL container.
DATABASE_URL=postgresql+psycopg2://claimiq_local:change_me@127.0.0.1:5432/claimiq
JWT_SECRET=replace-this-with-a-long-random-local-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=120


# Azure Document Management / RAG
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_CONTAINER=policy-documents
AZURE_STORAGE_CONNECTION_STRING=
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX_NAME=policy-chunks
AZURE_SEARCH_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/openai/v1/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name
AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment-name
AZURE_OPENAI_API_KEY=
RAG_TOP_K=5
RAG_MIN_SEARCH_SCORE=0.5
MAX_DOCUMENT_SIZE_MB=10
