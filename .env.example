# Replace each YOUR_* value with your own credentials/settings. Keep .env private.
DATABASE_URL=postgresql+psycopg2://claimiq_local:YOUR_DATABASE_PASSWORD@127.0.0.1:5432/claimiq
JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET_REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_MINUTES=120
CLAIMIQ_DEMO_PASSWORD=YOUR_UNIQUE_DEMO_USER_PASSWORD


# Azure Document Management / RAG
AZURE_STORAGE_ACCOUNT_NAME=YOUR_STORAGE_ACCOUNT_NAME
AZURE_STORAGE_CONTAINER=policy-documents
AZURE_STORAGE_CONNECTION_STRING=YOUR_STORAGE_CONNECTION_STRING
AZURE_SEARCH_ENDPOINT=https://YOUR_SEARCH_SERVICE.search.windows.net
AZURE_SEARCH_INDEX_NAME=policy-chunks
AZURE_SEARCH_API_KEY=YOUR_SEARCH_ADMIN_KEY
AZURE_OPENAI_ENDPOINT=https://YOUR_OPENAI_RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=YOUR_EMBEDDING_DEPLOYMENT_NAME
AZURE_OPENAI_CHAT_DEPLOYMENT=YOUR_CHAT_DEPLOYMENT_NAME
AZURE_OPENAI_API_KEY=YOUR_OPENAI_API_KEY
RAG_TOP_K=5
RAG_MIN_SEARCH_SCORE=0.5
MAX_DOCUMENT_SIZE_MB=10
